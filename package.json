{
  "name": "poor-man-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "yarn dev",
    "dev": "concurrently -n web,api,node -c cyan,magenta,yellow \"vite\" \"python -m uvicorn server.main:app --reload --app-dir . --host 127.0.0.1 --port 8000\" \"node cli/node_gateway.mjs\"",
    "dev:web": "vite",
    "dev:api": "python -m uvicorn server.main:app --reload --app-dir . --host 127.0.0.1 --port 8000",
    "dev:node": "node cli/node_gateway.mjs",
    "build": "tsc && vite build",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project zerogravity-ab52d --non-interactive",
    "deploy:functions": "firebase deploy --only functions:poor-man-ai --project zerogravity-ab52d --non-interactive",
    "preview": "vite preview",
    "prepare:kaggle": "python scripts/prepare_kaggle_dataset.py && python scripts/generate_notebook.py"
  },
  "dependencies": {
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
