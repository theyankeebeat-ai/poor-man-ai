{
  "functions": [{
    "source": "functions",
    "codebase": "poor-man-ai",
    "ignore": ["node_modules", ".git", "*.log", "*.test.cjs"]
  }],
  "hosting": {
    "site": "zerogravity-ab52d",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/", "destination": "/chat", "type": 302 },
      { "source": "/real-ai{,/**}", "destination": "/chat", "type": 302 },
      { "source": "/architecture{,/**}", "destination": "/chat", "type": 302 },
      { "source": "/webai{,/**}", "destination": "/chat", "type": 302 },
      { "source": "/browser{,/**}", "destination": "/chat", "type": 302 },
      { "source": "/brain{,/**}", "destination": "/chat", "type": 302 },
      { "source": "/server{,/**}", "destination": "/chat", "type": 302 },
      { "source": "/skill{,/**}", "destination": "/chat", "type": 302 },
      { "source": "/tools{,/**}", "destination": "/chat", "type": 302 },
      { "source": "/database{,/**}", "destination": "/chat", "type": 302 }
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
    ]
  }
}
