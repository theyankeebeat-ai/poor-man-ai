# SpaceXAI / xAI (preferred)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
XAI_VISION_MODEL=grok-4.6
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Search (first match wins): Tavily, Brave, Serper, else Jina s.jina.ai
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# Image generation override (POST JSON spec, expect image bytes or URL)
IMAGE_GEN_URL=

# Vision override
VISION_API_KEY=

# Local media for local_video_summarize
LOCAL_MEDIA_ROOT=

# Agent
MAX_STEPS=8
