# Local API reads these. Do not commit .env.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET=hf

SUPABASE_URL=https://wqrriztbsifgytjzippi.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=hf

# Public API the Firebase host calls. Not a secret.
RENDER_API_URL=https://poor-man-ai.onrender.com
RENDER_SERVICE_ID=
RENDER_API_KEY=

FIREBASE_HOSTING=https://ai.usavisible.com
FIREBASE_PROJECT=zerogravity-ab52d

# local uses hf/ on disk; auto restores from Supabase, then Appwrite if needed.
HF_STORAGE_PROVIDER=local
HF_NUM_THREADS=1
# Optional absolute path to a writable snapshot cache.
# HF_SNAPSHOT_DIR=/tmp/poor-man-ai-hf
# Public frontend API URL (Vite reads this at build time).
VITE_API_URL=https://wqrriztbsifgytjzippi.supabase.co/functions/v1/api
